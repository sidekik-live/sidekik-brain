{
  "name": "sidekik-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekik's judgment layer: pause detector, question planner and Jev decisions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:mock": "tsx --env-file-if-exists=.env scripts/dev-mock.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "jev:smoke": "tsx --env-file-if-exists=.env scripts/jev-smoke.ts",
    "calibrate": "tsx --env-file-if-exists=.env scripts/calibrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@sidekik/contracts": "github:sidekik-live/sidekik-platform#v0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
